PORT=4000

# Phat trien cuc bo: dung file SQLite nhung, khong can tai khoan cloud.
# Production (Render): thay bang URL Turso that, vi du libsql://ten-db-xxxx.turso.io
DATABASE_URL=file:./local.db
# Chi can khi DATABASE_URL la libsql://... (Turso that) - lay tu Turso dashboard/CLI.
DATABASE_AUTH_TOKEN=

# Chuoi bi mat de ky JWT (phien dang nhap Admin). Production PHAI doi sang 1
# chuoi ngau nhien dai, khong dung gia tri vi du nay.
JWT_SECRET=doi-chuoi-nay-thanh-ngau-nhien-that-dai-khi-len-production
