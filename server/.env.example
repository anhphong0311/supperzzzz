PORT=4000

# Phat trien cuc bo: dung file SQLite nhung, khong can tai khoan cloud.
# Production (Render): thay bang URL Turso that, vi du libsql://ten-db-xxxx.turso.io
DATABASE_URL=file:./local.db
# Chi can khi DATABASE_URL la libsql://... (Turso that) - lay tu Turso dashboard/CLI.
DATABASE_AUTH_TOKEN=

# Chuoi bi mat de ky JWT (phien dang nhap Admin). Production PHAI doi sang 1
# chuoi ngau nhien dai, khong dung gia tri vi du nay.
JWT_SECRET=doi-chuoi-nay-thanh-ngau-nhien-that-dai-khi-len-production

# Dong bo Kho video (Google Sheet + Drive) - 1 Service Account CHUNG luu tren
# server, khong con phat file key cho tung may nhan vien.
# GOOGLE_SHEET_ID: lay tu URL Sheet (docs.google.com/spreadsheets/d/{SHEET_ID}/edit)
GOOGLE_SHEET_ID=
# GOOGLE_SHEET_TAB_NAME: ten tab (sheet con) chua du lieu, mac dinh Sheet1
GOOGLE_SHEET_TAB_NAME=Sheet1
# GOOGLE_SERVICE_ACCOUNT_KEY_BASE64: noi dung file JSON key cua Service
# Account, ma hoa base64 (xem huong dan trong README.md)
GOOGLE_SERVICE_ACCOUNT_KEY_BASE64=
